# Optional — AI "smart answers" for the cabin consultant. Without any key the
# consultant still works fully (guided, catalogue-driven flow + quotations).
# Server-side only: never prefix these with NEXT_PUBLIC_.

# Google Gemini (Google AI Studio key)
GEMINI_API_KEY=
# Optional model override (default: gemini-flash-latest)
GEMINI_MODEL=

# Or Anthropic Claude
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5). Cheaper option: claude-haiku-5-5
ANTHROPIC_MODEL=

# Optional: "gemini" or "anthropic" when both keys are set (default: gemini)
AI_PROVIDER=

# Optional — final domain for canonical URLs / sitemap
NEXT_PUBLIC_SITE_URL=
