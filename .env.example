# Optional — only needed for the cabin consultant's "smart answers" to free-form questions.
# Without it the consultant still works fully (guided, catalogue-driven flow + quotations).
# Server-side only: never prefix these with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5). Cheaper option: claude-haiku-5-5
ANTHROPIC_MODEL=

# Optional — final domain for canonical URLs / sitemap
NEXT_PUBLIC_SITE_URL=
